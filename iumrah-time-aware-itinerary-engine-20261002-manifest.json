  "schema": "iumrah.beta.update.v1",
  "name": "time-aware-itinerary-engine",
  "date": "2026-10-02",
  "requires_package_engine_deploy": true,
  "requires_testflight_build": true,
  "d1_migration_required": false,
  "architecture": {
    "timezone": "Asia/Riyadh",
    "airport_exit_minutes": 120,
    "international_airport_buffer_minutes": 180,
    "jed_makkah_transfer_minutes": 105,
    "med_madinah_transfer_minutes": 40,
    "cross_city_transfer_minutes": 300,
    "haramain_door_to_door_minutes": 210,
    "hotel_standard_checkin": "15:00",
    "hotel_standard_checkout": "12:00"
  },
  "notes": [
    "Server verifies flight timestamps from curated inventory or the server flight cache; client-supplied times are not trusted for hotel-night pricing.",
    "If exact provider schedule is unavailable or clearly inconsistent, existing requested-night behavior is preserved as a fail-safe.",
    "Existing bookings may receive a richer display itinerary if their stored generatorTrace contains exact flight times; historical financial terms are not repriced.",
    "New quotes persist the authoritative stayPlan into booking data and validate hotel-night counts against the sealed quote."
  ],
