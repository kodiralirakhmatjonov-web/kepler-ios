{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iumrah-package-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "triggers": {
    "crons": ["17 0 * * *"]
  },
  "routes": [
    {
      "pattern": "iumrah.app/api/package*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/api/admin/package*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/.well-known/apple-app-site-association",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/hotel/*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/h/*",
      "zone_id": "__ZONE_ID__"
    }
  ],
  "d1_databases": [
    {
      "binding": "HOTELS_DB",
      "database_name": "iumrah-hotels",
      "database_id": "__D1_DATABASE_ID__"
    },
    {
      "binding": "BOOKINGS_DB",
      "database_name": "__BOOKING_D1_DATABASE_NAME__",
      "database_id": "__BOOKING_D1_DATABASE_ID__"
    }
  ],
  "migrations": [
    {
      "tag": "v1-package-search-session",
      "new_sqlite_classes": ["PackageSearchSession"]
    },
    {
      "tag": "v2-remove-package-search-session",
      "deleted_classes": ["PackageSearchSession"]
    }
  ],
  "vars": {
    "APPLE_BUNDLE_ID": "com.iumrah.app",
    "GOOGLE_SERVER_CLIENT_ID": "863185716777-8tec2kuch1qkra1f1coikpi20j6is65f.apps.googleusercontent.com",
    "IGNAV_MONTHLY_REQUEST_BUDGET": "3000",
    "ACCOUNT_EMAIL_FROM": "security@iumrah.app",
    "ACCOUNT_EMAIL_REPLY_TO": "support@iumrah.app",
    "WALLET_PASS_TYPE_ID": "pass.com.iumrah.id",
    "WALLET_TEAM_ID": "2DQ678JTNG",
    "WALLET_ORGANIZATION_NAME": "iumrah"
  }
}
